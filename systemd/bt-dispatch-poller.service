[Unit]
Description=BT dispatch bot - CRM poller
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=btbot
WorkingDirectory=/opt/bt-dispatch-bot
ExecStart=/opt/bt-dispatch-bot/.venv/bin/python poller.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# Скопировать в .env и заполнить. .env в git не попадает.

# --- CRM ---
CRM_BASE_URL=https://bt-lead-centre.ru
CRM_USERNAME=
CRM_PASSWORD=

# Имена полей формы входа на /admin/login, сняты с живой страницы 16.09.2026.
# Вход по email, а не по имени пользователя.
CRM_LOGIN_FIELD_USERNAME=LoginForm[email]
CRM_LOGIN_FIELD_PASSWORD=LoginForm[password]

# Защита боевой CRM: при true ни один пишущий запрос не уходит.
# Этап 1 не пишет вообще, флаг оставлен включённым на будущее.
# Пока true — в CRM не уходит ни один пишущий запрос.
CRM_READ_ONLY=true
# Предохранитель: непустой список = писать только в эти заявки.
CRM_WRITE_ONLY_FOR=
CRM_TIMEOUT_SEC=30

# --- Филиал ---
CITY_ID=206
POLL_INTERVAL_SEC=60

# --- Telegram ---
# id чатов узнаются командой /chatid у запущенного bot.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=
# Общий чат мастеров: туда в 09:00 уходит сбор смены с кнопкой «+ на смене»
MASTERS_CHAT_ID=
DISPATCHERS_CHAT_ID=
ADMIN_CHAT_ID=
DIRECTOR_CHAT_ID=

# --- БД ---
DATABASE_URL=postgresql://btbot:CHANGEME@localhost:5432/btdispatch

# --- Прочее ---
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# --- Распределение ---
# Грид отдаёт и закрытые заявки, поэтому статус решает всё.
# Перечисляем незакрытые: незнакомый статус считается закрытым и бот его не трогает.
ACTIVE_STATUSES=Ожидает,В пути,В работе,В работе СД
ASSIGNABLE_STATUSES=Ожидает
# 0 — раздавать сразу при уведомлении директору, если есть свободный мастер.
ASSIGN_LEAD_MIN=0
# Тревога «нет свободных» — за столько минут до визита, не сразу.
ESCALATE_LEAD_MIN=60
ASSIGN_WINDOW_START=09:00
ASSIGN_WINDOW_END=22:00
# Принятие заявки: на 5-й минуте повтор мастеру и сигнал директору,
# на 15-й заявка уходит следующему по кругу.
ACCEPT_REMINDER_MIN=5
ACCEPT_TIMEOUT_MIN=15
ONSITE_TIMEOUT_MIN=55
SHIFT_CHECK_TIME=09:00
